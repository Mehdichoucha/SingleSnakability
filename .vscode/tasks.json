{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build SDLTest",
      "type": "shell",
      "command": "g++",
      "args": [
        "main.cpp",
        "-o",
        "SDLTest.exe",
        "-IC:/SDL3/include",
        "-LC:/SDL3/lib",
        "-lSDL3"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}